<template>
  <div class="page" onswipe="swipe">
    <div if="{{mode === 'title' || mode === 'play'}}" class="art" onclick="advance">
      <image if="{{mode === 'title'}}" class="background" src="/common/title_bg.png" onerror="backgroundError" oncomplete="backgroundLoaded"></image>
      <div if="{{mode === 'play'}}" class="scene-viewport"><image for="{{sceneImages}}" tid="key" class="scene-layer" style="width: {{$item.width}}px; height: {{$item.height}}px; top: {{$item.top}}px; left: {{$item.left}}px; opacity: {{$item.opacity}};" src="{{$item.src}}" onerror="backgroundError"></image></div>
    </div>
    <div if="{{mode === 'title'}}" class="title-panel">
      <text class="title-text">命运石之门</text>
      <text class="title-subtitle">{{progressLabel}}</text>
      <text class="title-action" onclick="startNew">开始游戏</text>
      <text class="title-action secondary" onclick="continueGame">读取存档</text>
      <text class="title-action secondary" onclick="openGallery">CG 鉴赏</text>
      <text class="title-action secondary" onclick="openRoutes">选择章节</text>
    </div>
    <div if="{{mode === 'play'}}" class="dialogue-panel">
      <div class="speaker-row"><text class="speaker" style="font-family: {{speakerFont}};">{{speaker}}</text><text class="chapter" style="font-family: {{chapterFont}};">{{chapterLabel}}</text></div>
      <scroll id="dialogue-scroll" class="dialogue-scroll" scroll-y="true" onclick="dialogueTap" ontouchstart="dialogueTouchStart" ontouchmove="dialogueTouchMove" ontouchend="dialogueTouchMove" onscroll="dialogueScrolled"><text class="dialogue" style="height: {{dialogueHeight}}px;font-size: {{fontSize}}px;font-family: {{dialogueFont}};">{{displayText}}</text></scroll>
      <div class="toolbar"><text class="tool" onclick="goBack">上一句</text><text class="tool" onclick="showMenu">菜单</text><text class="tool" onclick="showPhone">手机</text><text class="tool" onclick="advance">下一句 ›</text></div>
    </div>
    <div if="{{mode === 'choice'}}" class="choice-panel full-choice">
      <scroll id="mail-scroll" class="choice-heading" style="height: {{choiceViewport}}px;" scroll-y="true"><div class="mail-content" style="height: {{choiceHeadingHeight}}px;"><text if="{{choiceTag !== ''}}" class="choice-tag">{{choiceTag}}</text><text class="choice-title" style="height: {{choiceTextHeight}}px;font-family: {{choiceHeadingFont}};">{{choiceHeading}}</text></div></scroll>
      <scroll class="choice-list" style="height: {{choiceListHeight}}px;" scroll-y="true"><div for="{{options}}" tid="key" class="choice" onclick="pick($idx)"><text if="{{$item.label}}" class="choice-role">{{$item.label}}</text><text class="choice-content" style="font-family: {{$item.font}};">{{$item.text}}</text></div></scroll>
      <text class="small-action" onclick="showMenu">菜单</text>
    </div>
    <div if="{{mode === 'menu'}}" class="overlay">
      <text class="menu-title">阅读菜单</text>
      <text class="menu-action" onclick="saveGame">保存进度</text>
      <text class="menu-action" onclick="loadGame">读取进度</text>
      <text class="menu-action" style="color: {{hasNextChapter ? '#d5e5f2' : '#64758a'}};" onclick="goNextChapter">下一章 ›</text>
      <text class="menu-action" onclick="toggleSpeed">{{speedLabel}}</text>
      <text class="menu-action" onclick="toggleFont">{{fontLabel}}</text>
      <text class="menu-action" onclick="resume">返回游戏</text>
      <text class="menu-action muted" onclick="toTitle">返回标题</text>
    </div>
    <div if="{{mode === 'routes' || mode === 'chapters'}}" class="full-panel">
      <text class="panel-title">{{browseTitle}}</text><text class="panel-subtitle" style="font-family: {{browseFont}};">{{browseLabel}}</text>
      <div class="slot-list"><div for="{{browseRows}}" tid="key" class="slot-card" onclick="selectBrowse($idx)"><text class="slot-title" style="font-family: {{$item.font}};">{{$item.name}}</text><text class="slot-meta">{{$item.detail}}</text></div></div>
      <div class="pager"><text class="pager-action" onclick="previousBrowse">‹ 上一页</text><text class="pager-action" onclick="closeBrowse">返回</text><text class="pager-action" onclick="nextBrowse">下一页 ›</text></div>
    </div>
    <div if="{{mode === 'slots'}}" class="full-panel">
      <text class="panel-title">{{slotTitle}}</text>
      <text class="panel-subtitle">{{slotPageLabel}}</text>
      <div class="slot-list">
        <div for="{{slotRows}}" tid="number" class="slot-card" style="background-color: {{$item.occupied ? '#1d3549' : '#142535'}};" onclick="selectSlot($item.index)">
          <text class="slot-title">{{$item.title}}</text><text class="slot-meta" style="font-family: {{$item.metaFont}};">{{$item.meta}}</text><text class="slot-preview" style="font-family: {{$item.previewFont}};">{{$item.preview}}</text>
        </div>
      </div>
      <div class="pager"><text class="pager-action" onclick="previousSlotPage">‹ 上一页</text><text class="pager-action" onclick="closeSlots">返回</text><text class="pager-action" onclick="nextSlotPage">下一页 ›</text></div>
    </div>
    <div if="{{mode === 'overwrite'}}" class="overlay">
      <text class="menu-title">{{overwriteTitle}}</text>
      <text class="confirm-text" style="font-family: {{overwriteFont}};">{{overwriteDetail}}</text>
      <text class="menu-action" onclick="confirmOverwrite">确认覆盖</text><text class="menu-action muted" onclick="cancelOverwrite">取消</text>
    </div>
    <div if="{{mode === 'gallery'}}" class="full-panel">
      <text class="panel-title">CG 鉴赏</text><text class="panel-subtitle">{{galleryPageLabel}}</text>
      <div class="gallery-row"><div for="{{galleryTop}}" tid="image" class="gallery-card" onclick="viewCg($item.index)"><image class="gallery-thumb" src="{{$item.src}}"></image><text class="gallery-caption" style="font-family: {{$item.font}};">{{$item.label}}</text></div></div>
      <div class="gallery-row"><div for="{{galleryBottom}}" tid="image" class="gallery-card" onclick="viewCg($item.index)"><image class="gallery-thumb" src="{{$item.src}}"></image><text class="gallery-caption" style="font-family: {{$item.font}};">{{$item.label}}</text></div></div>
      <div class="pager"><text class="pager-action" onclick="previousGalleryPage">‹ 上一页</text><text class="pager-action" onclick="toTitle">返回标题</text><text class="pager-action" onclick="nextGalleryPage">下一页 ›</text></div>
    </div>
    <div if="{{mode === 'cg'}}" class="cg-panel">
      <image class="cg-image" src="{{cgSrc}}" onclick="cycleCg"></image><text class="cg-caption" style="font-family: {{cgFont}};">{{cgLabel}}</text>
      <div class="cg-controls"><text class="pager-action" onclick="previousCg">‹ 上一组</text><text class="pager-action" onclick="backToGallery">返回列表</text><text class="pager-action" onclick="nextCg">下一组 ›</text></div>
    </div>
    <div if="{{mode === 'end'}}" class="end-panel"><text class="game-title">{{endingLabel}}</text><text class="subtitle">故事阅读完毕</text><text class="action" onclick="toTitle">返回标题</text></div>
    <div if="{{mode === 'error'}}" class="overlay"><text class="menu-title">暂时无法继续</text><text class="error-text">{{errorText}}</text><text class="action" onclick="toTitle">返回标题</text></div>
    <text if="{{loading}}" class="loading">加载中…</text>
  </div>
</template>
<script>
import file from '@system.file';
import storage from '@system.storage';
import prompt from '@system.prompt';
import {configure,provideMailText,provideChannelText,newState,newChapterState,restore,readFrame,readChapterSkip,next,nextChapter,choose,previous,previewMap,openPhone,storyDate,recoverGraphics} from '../../common/engine.js';
import {SLOT_COUNT,LEGACY_KEY,slotKey,decodeSave,decodeSlotMeta,createSave,slotRow} from '../../common/saves.js';
import {catalog} from '../../common/catalog.js';
import {imagePath,galleryImagePath} from '../../common/assets.js';
import {groupGallery,stepVariant} from '../../common/gallery.js';
import {textFont,cleanText,dialogueText,wrapText} from '../../common/text-font.js';
import {portraitBox} from '../../common/portrait-layout.js';
import {PROGRESS_KEY,emptyProgress,decodeProgress,progressFromState,withProgress,initializeProgress} from '../../common/progress.js';
export default {
  private:{mode:'title',sceneImages:[],backgroundSrc:'/common/title_bg.png',bodySrc:'',bodySecond:'',bodyThird:'',portraitWidth:200,portraitLeft:116,portraitSecondLeft:216,speaker:'',displayText:'',chapterLabel:'',speakerFont:'sans-serif',dialogueFont:'sans-serif',chapterFont:'sans-serif',browseFont:'sans-serif',overwriteFont:'sans-serif',cgFont:'sans-serif',
    choiceHeading:'选择下一步',choiceHeadingFont:'sans-serif',choiceTag:'',choiceTextHeight:56,choiceHeadingHeight:100,choiceViewport:134,choiceListHeight:296,dialogueHeight:128,options:[],loading:false,errorText:'',hasNextChapter:true,fontSize:24,textSpeed:30,speedLabel:'显示速度：逐字',fontLabel:'字号：标准',progressLabel:'红米手表 5 · 图文版',
    portraitHeight:286,portraitTop:0,portraitSecondWidth:200,portraitSecondHeight:286,portraitSecondTop:0,portraitThirdWidth:144,portraitThirdHeight:286,portraitThirdTop:0,portraitThirdLeft:288,
    slotTitle:'',slotPage:0,slotPageLabel:'',slotRows:[],storageBusy:false,overwriteTitle:'',overwriteDetail:'',endingLabel:'本篇阅读完毕',
    galleryPage:0,galleryPageLabel:'',galleryTop:[],galleryBottom:[],cgIndex:0,cgVariant:0,cgSrc:'',cgLabel:'',browseRows:[],browseTitle:'',browseLabel:'',browsePage:0},
  onInit(){
    this.session=newState();this.cachedChapter=0;this.ops=[];this._blockCache={};this._blockOrder=[];this.loadSequence=0;this.timer=null;this.fullText='';this.resumeMode='play';
    this._slotsSequence=0;this._gallerySequence=0;this._slotData=[];this._galleryCatalog=[];this._galleryTotal=0;this._slotsReturnMode='title';this._slotRole='load';
    this._progress=emptyProgress();this._progressWriteBusy=false;this._progressDirty=false;this._progressReady=false;this.loading=true;
    storage.get({complete:()=>{},key:'steins_rw5_settings_v1',success:data=>{try{const s=JSON.parse(data);this.fontSize=s.fontSize===28?28:24;this.textSpeed=s.textSpeed===0?0:30;this.refreshSettings();}catch(e){}},fail:()=>{}});
    this.readRuntime();
    console.log('STEINS_RW5 title ready');
  },
  backgroundLoaded(){console.log('STEINS_RW5 background loaded',this.mode,this.backgroundSrc);},
  backgroundError(){console.log('STEINS_RW5 background failed',this.mode,this.backgroundSrc);},
  clearTyping(){if(this.timer!==null){clearTimeout(this.timer);this.timer=null;}},
  onShow(){this._hidden=false;if(this._renderPending&&this.timer===null)this.renderFrame();},
    onHide(){this._hidden=true;this.clearTyping();if(!this.loading&&this.mode==='play')this.displayText=this.fullText;},
  onDestroy(){this.clearTyping();this.loadSequence++;this._slotsSequence++;this._gallerySequence++;},
  readRuntime(){const files=['memory','mail-index','runtime-assets','channel-index'];const loaded={};const load=i=>{file.readText({uri:'/common/'+files[i]+'.txt',complete:()=>{},success:data=>{try{loaded[files[i]]=JSON.parse(data.text);if(i+1<files.length){setTimeout(()=>load(i+1),0);return;}configure(loaded.memory,loaded['mail-index'],loaded['runtime-assets'],loaded['channel-index']);this.readProgress();}catch(e){this.fail(e.message);}},fail:()=>this.fail('资源初始化失败')});};load(0);},
  exitApp(){this.clearTyping();this.$app.exit();},
  readProgress(){this.loading=true;storage.get({complete:()=>{},key:PROGRESS_KEY,default:'',success:data=>{try{this._progress=decodeProgress(data);this._progressReady=true;this.refreshProgress();this.loading=false;}catch(e){this.fail(e.message);}},fail:()=>{this.fail('通关记录读取失败，请返回标题重试');}});},
  startNew(){if(this.loading||!this._progressReady)return;this.clearTyping();this.loading=true;this.mode='loading';this.clearStoryCache();this.sceneImages=[];this._slotData=[];const seq=++this.loadSequence;setTimeout(()=>file.readText({uri:'/common/startup.txt',complete:()=>{},success:data=>{if(seq!==this.loadSequence)return;try{const state=JSON.parse(data.text);state.history=[];this.session=initializeProgress(state,this._progress);this._autoHops=0;this.renderFrame();}catch(e){this.fail(e.message);}},fail:()=>this.fail('初始状态读取失败')}),0);},
  refreshProgress(){this.progressLabel='红米手表 5 · 图文版';},
  syncProgress(){
    if(!this._progressReady||this.session.progression!=='story')return;const progress=progressFromState(this.session);
    if(JSON.stringify(progress)===JSON.stringify(this._progress))return;
    this._progress=progress;this._progressDirty=true;this.refreshProgress();this.writeProgress();
  },
  writeProgress(){
    if(this._progressWriteBusy||!this._progressDirty)return;this._progressWriteBusy=true;this._progressDirty=false;
    const payload=JSON.stringify(this._progress);
    storage.set({complete:()=>{},key:PROGRESS_KEY,value:payload,success:()=>{this._progressWriteBusy=false;this.writeProgress();},fail:()=>{this._progressWriteBusy=false;this._progressDirty=true;this.toast('通关记录保存失败，请重试保存或返回标题');}});
  },
  openRoutes(){if(this.loading)return;this.clearTyping();this._browseRoute=0;this.mode='chapters';this.browsePage=0;this.refreshBrowse();},
  visibleText(text){return cleanText(text).replace(/・/g,'·');},
  characterName(name){return name;},
  visibleOptions(items){return items.map((item,index)=>{const text=wrapText(this.visibleText(item.text),364,21);return Object.assign({},item,{key:this.session.chapter+':'+this.session.cursor+':'+item.action+':'+(item.id===undefined?'':item.id)+':'+index,text,font:textFont(text)});});},
  refreshBrowse(){const routes=this.mode==='routes';this._browseItems=routes?catalog.routes:catalog.chapters.filter(x=>x.route===this._browseRoute);this.browseTitle=routes?'选择路线':'选择章节';const start=this.browsePage*4;this.browseRows=this._browseItems.slice(start,start+4).map((item,i)=>({key:(routes?'route:':'chapter:'+this._browseRoute+':')+(start+i),index:start+i,name:this.visibleText(item.name),font:textFont(item.name),detail:routes?item.scenes.length+' 个章节':'点击开始阅读'}));this.browseLabel=(routes?'章节阅读 · ':this.visibleText(catalog.routes[this._browseRoute].name)+' · ')+(this.browsePage+1)+' / '+Math.ceil(this._browseItems.length/4);this.browseFont=textFont(this.browseLabel);},
  previousBrowse(){if(this.browsePage>0){this.browsePage--;this.refreshBrowse();}},
  nextBrowse(){if(this.browsePage<Math.ceil(this._browseItems.length/4)-1){this.browsePage++;this.refreshBrowse();}},
  selectBrowse(row){const index=this.browsePage*4+row;if(this.mode==='routes'){this._browseRoute=index;this.browsePage=0;this.mode='chapters';this.refreshBrowse();return;}const item=this._browseItems[index];if(!item)return;this.session=withProgress(newChapterState(item),this._progress);if(item.mailRead)this.session.letters[item.mailRead]=2;this.cachedChapter=0;this._autoHops=0;this.renderFrame();},
  closeBrowse(){this.toTitle();},
  continueGame(){this.openSlots('load');},
  clearStoryCache(){this.cachedChapter=0;this.ops=[];this._blockCache={};this._blockOrder=[];this._blockSizes={};this._blockBytes=0;},
  cacheBlock(key,ops,size){if(!this._blockSizes)this._blockSizes={};if(ops){this._blockCache[key]=ops;this._blockBytes=(this._blockBytes||0)-(this._blockSizes[key]||0)+(size||0);this._blockSizes[key]=size||0;}const old=this._blockOrder.indexOf(key);if(old>=0)this._blockOrder.splice(old,1);this._blockOrder.push(key);while(this._blockOrder.length>3||(this._blockBytes>40000&&this._blockOrder.length>1)){const drop=this._blockOrder.shift();delete this._blockCache[drop];this._blockBytes-=this._blockSizes[drop];delete this._blockSizes[drop];}},
  readResource(frame){const kind=frame.mail!==undefined?'mail':'channel',id=frame[kind],seq=++this.loadSequence;this.loading=true;file.readText({uri:'/common/'+kind+'/'+id+'.txt',complete:()=>{},success:data=>{if(seq!==this.loadSequence)return;try{const rows=JSON.parse(data.text);if(kind==='mail')provideMailText(id,rows);else provideChannelText(id,rows);this.timer=setTimeout(()=>{this.timer=null;this.renderFrame();},0);}catch(e){this.fail(e.message);}},fail:()=>this.fail('手机内容读取失败')});},
  readChapter(chapter,done){
    const block=Math.floor(this.session.cursor/512),key=chapter+':'+block;
    if(this.cachedChapter===key){done();return;}
    if(this._blockCache[key]){this.ops=this._blockCache[key];this.cacheBlock(key);this.opsBase=block*512;this.cachedChapter=key;done();return;}
    this.loading=true;const seq=++this.loadSequence;
    file.readText({complete:()=>{},uri:'/common/story/'+chapter+'/'+block+'.txt',success:data=>{
      if(seq!==this.loadSequence)return;
      try{const ops=JSON.parse(data.text);if(!Array.isArray(ops))throw new Error('章节格式无效');this.ops=ops;this.opsBase=block*512;this.cachedChapter=key;this.cacheBlock(key,ops,data.text.length);this.loading=true;this.timer=setTimeout(()=>{this.timer=null;done();},0);}
      catch(e){this.fail(e.message);}
    },fail:(data,code)=>{if(seq===this.loadSequence)this.fail('第 '+chapter+' 章读取失败：'+code+' '+String(data||'').slice(0,100));}});
  },
  renderFrame(){
    this.loading=true;this._renderPending=true;this.clearTyping();this.readChapter(this.session.chapter,()=>{
      if(this._hidden)return;
      try{
        let f;const started=Date.now(),batchLimit=this._chapterSkip?64:12,budget=this._chapterSkip?40:12;
        for(let batch=0;batch<batchLimit;batch++){
          f=this._chapterSkip?readChapterSkip(this.ops,this.session,this._chapterSkip,this.opsBase,catalog.scenes[String(this.session.chapter)].length):readFrame(this.ops,this.session,this.opsBase,catalog.scenes[String(this.session.chapter)].length);
          if(f.type!=='jump'&&f.type!=='yield')break;
          this._autoHops=(this._autoHops||0)+1;if(this._autoHops>20000)throw new Error('剧情暂未推进，请读取存档重试');
          const block=Math.floor(this.session.cursor/512),key=this.session.chapter+':'+block;
          if(batch<batchLimit-1&&Date.now()-started<budget&&this._blockCache[key]){this.ops=this._blockCache[key];this.cacheBlock(key);this.opsBase=block*512;this.cachedChapter=key;continue;}
          this.timer=setTimeout(()=>{this.timer=null;this.renderFrame();},0);return;
        }
        if(f.type==='resource'){this.readResource(f);return;}
        this.syncProgress();
        this._autoHops=0;this._chapterSkip=null;this._renderPending=false;this.loading=false;
        this.backgroundSrc=imagePath(this.session.background);
        this.sceneImages=(this.session.sceneLayers||[]).map(x=>Object.assign({},x,{src:imagePath(x.image)}));
        const bodies=this.session.bodies||[];this.bodySrc=bodies[0]?imagePath(bodies[0]):'';this.bodySecond=bodies[1]?imagePath(bodies[1]):'';this.bodyThird=bodies[2]?imagePath(bodies[2]):'';
        const first=portraitBox(this.bodySrc,bodies.length,0),second=portraitBox(this.bodySecond,bodies.length,1),third=portraitBox(this.bodyThird,bodies.length,2);
        this.portraitWidth=first.width;this.portraitHeight=first.height;this.portraitTop=first.top;this.portraitLeft=first.left;
        this.portraitSecondWidth=second.width;this.portraitSecondHeight=second.height;this.portraitSecondTop=second.top;this.portraitSecondLeft=second.left;
        this.portraitThirdWidth=third.width;this.portraitThirdHeight=third.height;this.portraitThirdTop=third.top;this.portraitThirdLeft=third.left;
        this.chapterLabel=storyDate(this.session);this.chapterFont='sans-serif';this.hasNextChapter=!this.session.ended;
        if(f.type==='map'){this.renderMap(f);return;}
        if(f.type==='choice'){this.choiceViewport=this.session.choice.kind==='mailView'?340:134;this.choiceListHeight=this.session.choice.kind==='mailView'?90:296;this.choiceHeading=wrapText(f.heading||'选择下一步',380,23);this.choiceTag=f.category||'';this.choiceHeadingFont=textFont(this.choiceHeading);this.choiceTextHeight=this.choiceHeading.split('\n').length*30+8;this.choiceHeadingHeight=this.choiceTextHeight+(this.choiceTag?28:0);this.options=this.visibleOptions(f.items);this.mode='choice';try{this.$element('mail-scroll').scrollTo({top:0,left:0,behavior:'instant'});}catch(e){}console.log('STEINS_RW5 choice',this.session.chapter,this.session.cursor,this.session.choice.kind);return;}
        if(f.type==='end'){this.mode='end';this.endingLabel=(this.session.endingName||'本篇')+' · 阅读完毕';console.log('STEINS_RW5 ending',this.session.chapter,this.endingLabel);return;}
        this.mode='play';this.speaker=this.characterName(this.visibleText(f.speaker));this.fullText=wrapText(dialogueText(this.visibleText(f.text)),384,this.fontSize);this.dialogueHeight=this.fullText.split('\n').length*34+8;this.speakerFont=textFont(this.speaker);this.dialogueFont=textFont(this.fullText);this.displayText='';
        this.resetDialogueScroll();
        console.log('STEINS_RW5 frame',this.session.chapter,this.session.cursor);
        if(this.textSpeed===0){this.displayText=this.fullText;return;}
        const tick=()=>{this.displayText=this.fullText.slice(0,this.displayText.length+1);if(this.displayText.length<this.fullText.length)this.timer=setTimeout(tick,this.textSpeed);else this.timer=null;};tick();
      }catch(e){this.fail(e.message);}
    });
  },
  advance(){if(this.loading||this.mode!=='play')return;if(this.timer!==null){this.clearTyping();this.displayText=this.fullText;return;}next(this.session);this.renderFrame();},
  resetDialogueScroll(){try{this.$element('dialogue-scroll').scrollTo({top:0,left:0,behavior:'instant'});}catch(e){}},
  dialogueTouchStart(event){const p=(event.touches||event.changedTouches||[])[0];this._dialogueTouch=p?{x:p.clientX,y:p.clientY}:null;this._dialogueMoved=false;this._dialogueBlockedUntil=0;},
  dialogueTouchMove(event){const p=(event.changedTouches||event.touches||[])[0],start=this._dialogueTouch;if(p&&start&&(Math.abs(p.clientX-start.x)>8||Math.abs(p.clientY-start.y)>8)){this._dialogueMoved=true;this._dialogueBlockedUntil=Date.now()+300;}},
  dialogueScrolled(){this._dialogueMoved=true;this._dialogueBlockedUntil=Date.now()+300;},
  dialogueTap(){if(this._dialogueMoved||Date.now()<(this._dialogueBlockedUntil||0))return;this.advance();},
  renderMap(frame){this.loading=true;const seq=++this.loadSequence;file.readText({complete:()=>{},uri:'/common/map-preview.txt',success:data=>{if(seq!==this.loadSequence)return;try{const choices=previewMap(JSON.parse(data.text),this.session,frame);if(!choices.length)throw new Error('此地图阶段暂无支持的剧情选项，请返回标题选择其他篇章');this.options=this.visibleOptions(choices);this.mode='choice';this.loading=false;console.log('STEINS_RW5 map ready',this.session.chapter,this.session.cursor,choices.map(x=>x.value).join(','));}catch(e){this.fail(e.message);}},fail:()=>{if(seq===this.loadSequence)this.fail('地图选项读取失败');}});},
  goNextChapter(){if(this.loading||this.mode!=='menu')return;if(this.resumeMode==='choice'){this.mode='choice';this.toast('请先作出当前选择');return;}this.clearTyping();this._chapterSkip=nextChapter(this.session);if(!this._chapterSkip){this.toast('本篇已结束');return;}this._autoHops=0;this.loading=true;this.renderFrame();console.log('STEINS_RW5 safe chapter skip',this.session.chapter,this.session.cursor);},
  pick(index){if(this.mode!=='choice'||this.loading)return;choose(this.session,this.options[index],index);this.renderFrame();},
  showPhone(){if(this.loading||this.mode!=='play')return;this.clearTyping();this._chapterSkip=null;if(openPhone(this.session)){console.log('STEINS_RW5 phone opened',this.session.chapter,this.session.cursor);this.renderFrame();}},
  goBack(){if(this.loading||this.mode!=='play')return;this.clearTyping();if(previous(this.session)){if(this.session.progression==='story')withProgress(this.session,this._progress);this.renderFrame();}else this.toast('已经是第一句');},
  showMenu(){if(this.loading||(this.mode!=='play'&&this.mode!=='choice'))return;this.clearTyping();this.displayText=this.fullText;this.resumeMode=this.mode;this.mode='menu';console.log('STEINS_RW5 menu',this.session.chapter);},
  resume(){this.mode=this.resumeMode;},
  swipe(event){
    if(this.mode==='gallery'){if(event.direction==='left')this.nextGalleryPage();if(event.direction==='right')this.previousGalleryPage();return;}
    if(event.direction==='right'&&(this.mode==='play'||this.mode==='choice'))this.showMenu();
  },
  saveGame(){this.writeProgress();this.openSlots('save');},
  loadGame(){this.openSlots('load');},
  openSlots(role){
    if(this.loading||this.storageBusy)return;this.clearTyping();this._slotsReturnMode=this.mode;this._slotRole=role;
    this._pendingSave=role==='save'?createSave(this.session,this.resumeMode,Date.now()):null;
    this.slotTitle=role==='save'?'选择保存栏位':'选择读取栏位';this.slotPage=0;this.slotRows=[];this.mode='slots';this.loading=true;
    const seq=++this._slotsSequence;this._slotData=Array(SLOT_COUNT).fill(null);
    const ready=()=>{if(seq!==this._slotsSequence)return;this.loading=false;this.refreshSlotRows();console.log('STEINS_RW5 slots ready',role);};
    const finish=index=>{
      if(seq!==this._slotsSequence)return;
      if(index+1<SLOT_COUNT){setTimeout(()=>readSlot(index+1),0);return;}
      if(this._slotData[0]){ready();return;}
      storage.get({complete:()=>{},key:LEGACY_KEY,default:'',success:data=>{if(seq!==this._slotsSequence)return;try{const old=decodeSlotMeta(data);if(old){old.legacy=true;this._slotData[0]=old;}}catch(e){}ready();},fail:ready});
    };
    const readSlot=i=>{if(seq!==this._slotsSequence)return;storage.get({complete:()=>{},key:slotKey(i),default:'',success:data=>{if(seq!==this._slotsSequence)return;try{this._slotData[i]=decodeSlotMeta(data);}catch(e){this._slotData[i]={invalid:true};}finish(i);},fail:()=>{if(seq!==this._slotsSequence)return;this._slotData[i]={invalid:true};finish(i);}});};
    readSlot(0);
  },
  renderRestored(){if(!this.session.needsVisualRecovery){this.renderFrame();return;}this.loading=true;const state=this.session;file.readText({uri:'/common/visual/'+(state.rootChapter||state.chapter)+'.txt',complete:()=>{},success:data=>{if(this.session!==state)return;try{recoverGraphics(state,JSON.parse(data.text));}catch(e){}this.loading=false;this.renderFrame();},fail:()=>{if(this.session===state){this.loading=false;this.renderFrame();}}});},
  refreshSlotRows(){const start=this.slotPage*4;const rows=[];for(let i=start;i<Math.min(start+4,SLOT_COUNT);i++)rows.push(slotRow(i,this._slotData[i]));this.slotRows=rows;this.slotPageLabel=SLOT_COUNT+' 个栏位 · 第 '+(this.slotPage+1)+' / '+Math.ceil(SLOT_COUNT/4)+' 页';},
  previousSlotPage(){if(this.loading||this.slotPage===0)return;this.slotPage--;this.refreshSlotRows();},
  nextSlotPage(){if(this.loading||this.slotPage>=Math.ceil(SLOT_COUNT/4)-1)return;this.slotPage++;this.refreshSlotRows();},
  closeSlots(){if(this.storageBusy)return;this._slotsSequence++;this._slotData=[];this._pendingSave=null;this.loading=false;this.mode=this._slotsReturnMode;},
  selectSlot(index){
    if(this.loading||this.storageBusy||this.mode!=='slots'||index<0||index>=SLOT_COUNT)return;
    const saved=this._slotData[index];
    if(this._slotRole==='load'){
      if(!saved){this.toast('这个栏位还没有存档');return;}if(saved.invalid){this.toast('这个存档无法读取');return;}
      const seq=this._slotsSequence;this.loading=true;storage.get({complete:()=>{},key:saved.legacy?LEGACY_KEY:slotKey(index),default:'',success:data=>{if(seq!==this._slotsSequence)return;try{const full=decodeSave(data);if(!full)throw Error('存档不存在');this.session=full.state;if(this.session.progression==='story')withProgress(this.session,this._progress);this._slotData=[];this._pendingSave=null;this.clearStoryCache();this._slotsSequence++;this.renderRestored();console.log('STEINS_RW5 slot loaded',index+1,this.session.chapter,this.session.cursor);}catch(e){this.loading=false;this.toast(e.message);}},fail:()=>{this.loading=false;this.toast('存档读取失败');}});return;
    }
    this._pendingSlotIndex=index;
    if(saved){const row=slotRow(index,saved);this.overwriteTitle='覆盖'+row.title+'？';this.overwriteDetail=row.meta+'\n覆盖后将保存当前进度。';this.overwriteFont=textFont(this.overwriteDetail);this.mode='overwrite';console.log('STEINS_RW5 overwrite',index+1);return;}
    this.commitSlot();
  },
  confirmOverwrite(){if(this.mode==='overwrite')this.commitSlot();},
  cancelOverwrite(){if(!this.storageBusy)this.mode='slots';},
  commitSlot(){
    if(this.storageBusy||!this._pendingSave)return;
    const index=this._pendingSlotIndex,seq=this._slotsSequence,payload=this._pendingSave;payload.savedAt=Date.now();this.storageBusy=true;this.loading=true;
    storage.set({complete:()=>{},key:slotKey(index),value:JSON.stringify(payload),success:()=>{
      if(seq!==this._slotsSequence)return;this._slotData=[];this._pendingSave=null;this.storageBusy=false;this.loading=false;this._slotsSequence++;this.mode=this.resumeMode;
      this.toast('已保存到存档 '+('0'+(index+1)).slice(-2));console.log('STEINS_RW5 slot saved',index+1,payload.state.chapter,payload.state.cursor);
    },fail:()=>{if(seq!==this._slotsSequence)return;this.storageBusy=false;this.loading=false;this.toast('保存失败，请重试');}});
  },
  openGallery(){
    if(this.loading)return;this.clearTyping();this.mode='gallery';
    if(this._galleryCatalog.length){this.refreshGallery();return;}
    this.loading=true;const seq=++this._gallerySequence;
    file.readText({complete:()=>{},uri:'/common/gallery.txt',success:data=>{
      if(seq!==this._gallerySequence)return;
      try{const items=JSON.parse(data.text);if(!Array.isArray(items)||!items.length)throw new Error('CG 目录为空');this._galleryCatalog=groupGallery(items);this._galleryTotal=items.reduce((sum,item)=>sum+item.images.length,0);this.galleryPage=0;this.loading=false;this.refreshGallery();console.log('STEINS_RW5 gallery ready',this._galleryCatalog.length,items.length);}catch(e){this.fail(e.message);}
    },fail:(data,code)=>{if(seq===this._gallerySequence)this.fail('CG 目录读取失败：'+code);}});
  },
  refreshGallery(){const start=this.galleryPage*4;const items=this._galleryCatalog.slice(start,start+4).map((item,i)=>({image:item.image,label:item.label+'\n'+item.variants.length+' 张',index:start+i,font:textFont(item.label+'张'),src:galleryImagePath(item.image)}));this.galleryTop=items.slice(0,2);this.galleryBottom=items.slice(2,4);this.galleryPageLabel=this._galleryCatalog.length+' 组 · '+this._galleryTotal+' 张 · 第 '+(this.galleryPage+1)+' / '+Math.ceil(this._galleryCatalog.length/4)+' 页';},
  previousGalleryPage(){if(this.loading||this.galleryPage===0)return;this.galleryPage--;this.refreshGallery();},
  nextGalleryPage(){if(this.loading||this.galleryPage>=Math.ceil(this._galleryCatalog.length/4)-1)return;this.galleryPage++;this.refreshGallery();},
  viewCg(index){if(this.loading||index<0||index>=this._galleryCatalog.length)return;this.cgIndex=index;this.cgVariant=0;this.mode='cg';this.renderCg();},
  renderCg(){const group=this._galleryCatalog[this.cgIndex],item=group.variants[this.cgVariant];this.cgSrc=galleryImagePath(item.image);this.cgLabel=group.label+(group.variants.length>1?' · 差分 '+(this.cgVariant+1)+' / '+group.variants.length+' · 点击切换':'');this.cgFont=textFont(this.cgLabel);console.log('STEINS_RW5 cg',this.cgIndex+1,this.cgVariant+1,item.image);},
  cycleCg(){if(this.mode!=='cg'||this.loading)return;const count=this._galleryCatalog[this.cgIndex].variants.length;if(count<2)return;this.cgVariant=stepVariant(this.cgVariant,1,count);this.renderCg();},
  previousCg(){if(this.cgIndex>0)this.viewCg(this.cgIndex-1);},
  nextCg(){if(this.cgIndex<this._galleryCatalog.length-1)this.viewCg(this.cgIndex+1);},
  backToGallery(){this.galleryPage=Math.floor(this.cgIndex/4);this.refreshGallery();this.mode='gallery';},
  refreshSettings(){this.speedLabel=this.textSpeed===0?'显示速度：即时':'显示速度：逐字';this.fontLabel=this.fontSize===28?'字号：大':'字号：标准';},
  persistSettings(){storage.set({complete:()=>{},key:'steins_rw5_settings_v1',value:JSON.stringify({fontSize:this.fontSize,textSpeed:this.textSpeed}),success:()=>{},fail:()=>{}});},
  toggleSpeed(){this.textSpeed=this.textSpeed===0?30:0;this.refreshSettings();this.persistSettings();},
  toggleFont(){this.fontSize=this.fontSize===24?28:24;this.fullText=wrapText(dialogueText(this.visibleText(this.session.text)),384,this.fontSize);this.dialogueHeight=this.fullText.split('\n').length*34+8;this.displayText=this.fullText;this.resetDialogueScroll();this.refreshSettings();this.persistSettings();},
  toTitle(){if(this.storageBusy)return;this._renderPending=false;this._chapterSkip=null;this.syncProgress();this.writeProgress();this.clearTyping();this.loadSequence++;this._slotsSequence++;this._gallerySequence++;this.clearStoryCache();this._slotData=[];this._pendingSave=null;this.sceneImages=[];this.loading=false;this.mode='title';this.backgroundSrc='/common/title_bg.png';this.bodySrc='';this.bodySecond='';this.bodyThird='';if(!this._progressReady)this.readProgress();},
  toast(message){prompt.showToast({message,duration:1500,success:()=>{},fail:()=>{},complete:()=>{}});},
  fail(message){this._renderPending=false;this._chapterSkip=null;this.clearTyping();this.loading=false;this.mode='error';this.errorText=message;console.error('STEINS_RW5 error',message);}
}
</script>
<style>
@font-face {font-family:sgoriginal;src:url('/common/sg-original.ttf');}
.page{width:432px;height:514px;background-color:#0a111f;flex-direction:column;}
.art{position:absolute;top:0px;left:0px;width:432px;height:286px;justify-content:center;align-items:center;background-color:#000000;}
.background{width:432px;height:286px;object-fit:contain;}
.scene-viewport{position:absolute;left:0px;top:43px;width:432px;height:243px;overflow:hidden;}
.scene-layer{position:absolute;object-fit:fill;}
.body{position:absolute;top:0px;left:116px;width:200px;height:286px;object-fit:contain;}
.title-panel,.dialogue-panel,.choice-panel,.end-panel{position:absolute;top:286px;left:0px;width:432px;height:228px;flex-direction:column;padding:12px 18px;}
.title-text{font-size:26px;color:#f4f7ff;text-align:center;margin-bottom:2px;}
.title-subtitle{font-size:16px;color:#8d9cae;text-align:center;margin-bottom:4px;}
.title-action{height:27px;width:396px;margin-bottom:2px;color:#ffffff;background-color:#25445f;border-radius:10px;text-align:center;font-size:20px;}
.game-title{font-size:28px;color:#f4f7ff;text-align:center;margin-bottom:4px;}
.subtitle{font-size:18px;color:#8d9cae;text-align:center;margin-bottom:8px;}
.action{height:52px;width:396px;margin-bottom:6px;color:#ffffff;background-color:#25445f;border-radius:14px;text-align:center;font-size:24px;}
.secondary{background-color:#192b3d;}
.dialogue-panel{padding:0px;}
.speaker-row{position:absolute;left:18px;top:12px;width:396px;height:30px;justify-content:space-between;align-items:center;}
.speaker{width:222px;height:30px;font-size:23px;color:#9bdaed;}
.chapter{width:174px;height:30px;font-size:16px;color:#72849b;text-align:right;}
.dialogue-scroll{position:absolute;left:18px;top:48px;width:396px;height:128px;flex-direction:column;overflow:hidden;}
.dialogue{width:384px;color:#f4f7ff;line-height:34px;flex-shrink:0;}
.toolbar{position:absolute;left:18px;top:178px;height:42px;width:396px;justify-content:space-between;align-items:center;}
.tool{width:99px;font-size:18px;color:#b7cbdf;padding:8px;text-align:center;}
.choice-tag{font-size:17px;color:#d9bd87;text-align:center;margin-bottom:4px;}
.choice-heading{height:134px;width:396px;flex-direction:column;}
.mail-content{width:380px;flex-direction:column;flex-shrink:0;}
.choice-title{width:380px;font-size:23px;line-height:30px;color:#b8dbe9;text-align:left;flex-shrink:0;}
.choice{min-height:68px;width:396px;background-color:#25445f;border-radius:12px;flex-direction:column;justify-content:center;padding:8px;margin-bottom:6px;}
.choice-role{font-size:15px;color:#9bbdd7;text-align:center;}
.choice-content{width:380px;font-size:21px;line-height:25px;color:#ffffff;text-align:center;}
.small-action{font-size:18px;color:#9bacc0;text-align:center;}
.overlay{position:absolute;top:0px;left:0px;width:432px;height:514px;background-color:#0a111f;flex-direction:column;padding:22px 32px;}
.menu-title{height:36px;font-size:28px;color:#ffffff;text-align:center;margin-bottom:12px;}
.menu-action{height:50px;font-size:22px;color:#d5e5f2;background-color:#172b3c;border-radius:12px;margin-bottom:8px;text-align:center;}
.muted{color:#98aabd;}
.full-panel{position:absolute;top:0px;left:0px;width:432px;height:514px;background-color:#0a111f;flex-direction:column;padding:16px 18px;}
.panel-title{height:36px;font-size:28px;color:#ffffff;text-align:center;margin-bottom:4px;}
.panel-subtitle{height:22px;font-size:16px;color:#93a8bc;text-align:center;margin-bottom:6px;}
.slot-list{height:368px;width:396px;flex-direction:column;}
.slot-card{height:84px;width:396px;margin-bottom:8px;padding:7px 12px;flex-direction:column;border-radius:12px;}
.slot-title{height:26px;font-size:22px;color:#e5f0fa;}
.slot-meta{height:19px;font-size:16px;color:#9ab2c7;}
.slot-preview{height:22px;font-size:18px;color:#bfceda;}
.pager{height:44px;width:396px;justify-content:space-between;align-items:center;}
.pager-action{font-size:20px;color:#b7cbdf;padding:8px;}
.gallery-row{height:184px;width:396px;justify-content:space-between;}
.gallery-card{height:176px;width:192px;padding:6px;flex-direction:column;background-color:#142535;border-radius:12px;}
.gallery-thumb{height:116px;width:180px;object-fit:contain;background-color:#000000;}
.gallery-caption{height:48px;width:180px;font-size:18px;line-height:22px;color:#d5e5f2;text-align:center;}
.cg-panel{position:absolute;top:0px;left:0px;width:432px;height:514px;flex-direction:column;background-color:#000000;}
.cg-image{width:432px;height:432px;object-fit:contain;}
.cg-caption{width:432px;height:28px;font-size:18px;color:#d5e5f2;text-align:center;}
.cg-controls{width:432px;height:54px;padding:0px 10px;justify-content:space-between;align-items:center;background-color:#0a111f;}
.confirm-text{font-size:24px;color:#d5e5f2;margin:30px 0px;}
.error-text{font-size:22px;color:#eab7b7;margin-bottom:30px;}
.loading{position:absolute;top:234px;left:128px;width:176px;height:46px;text-align:center;font-size:23px;color:#ffffff;background-color:#253a50;border-radius:12px;}
.choice-panel{top:0px;height:514px;background-color:#0a111f;padding:18px;}
.choice-list{width:396px;height:416px;flex-direction:column;}
.full-choice{top:0px;height:514px;background-color:#0a111f;}
.choice-list{height:296px;width:396px;}
</style>

